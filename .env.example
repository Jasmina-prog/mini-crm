# Скопируйте в .env.local и заполните. .env.local в git не попадает.

# --- Фронтенд (публичные значения, уходят в браузер) ---
# Supabase → Project Settings → API Keys
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Публичный ключ: anon (eyJ...) или publishable (sb_publishable_...)
VITE_SUPABASE_ANON_KEY=

# --- Только для локальных скриптов (npm run seed / security-check) ---
# Секретный ключ: service_role или sb_secret_... НЕ добавлять в Vercel, НЕ коммитить.
SUPABASE_SERVICE_ROLE_KEY=
# Пароль, который получат демо-пользователи
SEED_PASSWORD=
